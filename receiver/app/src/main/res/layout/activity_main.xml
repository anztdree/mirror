<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#111418">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MASUKKAN KODE"
        android:textColor="#888"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etCode"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="------"
        android:textColorHint="#444"
        android:inputType="number"
        android:maxLength="6"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:letterSpacing="0.15"
        android:gravity="center"
        android:background="@drawable/edittext_bg"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF4D4F"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CONNECT"
        android:textSize="16sp"
        android:backgroundTint="#2D8CFF"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnClearCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="HAPUS KODE TERSIMPAN"
        android:textSize="12sp"
        android:backgroundTint="#444"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

</LinearLayout>
